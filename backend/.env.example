NODE_ENV=development
PORT=3333

# MySQL (docker-compose.yml na raiz do repositório, exposto na porta 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=crud_usuarios

# Sessão (express-session + passport)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
SESSION_TTL_MINUTES=30

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Usuário administrador criado pelo seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@crud.dev
ADMIN_PASSWORD=Admin@123
