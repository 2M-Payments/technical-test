{
  "info": {
    "name": "CRUD de Usuários por Região",
    "description": "Roteiro de teste dos 11 requisitos. Rode a coleção inteira em ordem (Run collection). Pré-requisito: API em http://localhost:3333 com migrations e seed executados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@crud.dev"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "adminId",
      "value": ""
    },
    {
      "key": "bulkIds",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "0. Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Cria a sessão (cookie crud.sid). O Postman guarda o cookie automaticamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sessão atual (me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Regiões disponíveis",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/regions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "regions"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Criar um usuário",
      "item": [
        {
          "name": "Criar usuário em 2 regiões (req. 11)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria.{{$timestamp}}@email.com\",\n  \"password\": \"senha-segura\",\n  \"status\": \"ACTIVE\",\n  \"regionCodes\": [\n    \"BR\",\n    \"GB\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set('userId', u.id);",
                  "pm.test('tem 2 regiões', () => pm.expect(u.regions).to.have.length(2));",
                  "pm.test('não expõe senha', () => pm.expect(u).to.not.have.property('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: dados inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"invalido\",\n  \"password\": \"123\",\n  \"regionCodes\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: região inexistente (400)",
          "request": {
            "method": "POST",
            "header": [
              {
