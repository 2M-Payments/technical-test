    {
      "name": "2. Criar em lote",
      "item": [
        {
          "name": "Criar 3 usuários",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "bulk"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"name\": \"Ana Lima\",\n      \"email\": \"ana.{{$timestamp}}@email.com\",\n      \"password\": \"senha-segura\",\n      \"status\": \"ACTIVE\",\n      \"regionCodes\": [\n        \"BR\"\n      ]\n    },\n    {\n      \"name\": \"Bob Smith\",\n      \"email\": \"bob.{{$timestamp}}@email.com\",\n      \"password\": \"senha-segura\",\n      \"status\": \"INACTIVE\",\n      \"regionCodes\": [\n        \"GB\",\n        \"US\"\n      ]\n    },\n    {\n      \"name\": \"Carla Dias\",\n      \"email\": \"carla.{{$timestamp}}@email.com\",\n      \"password\": \"senha-segura\",\n      \"status\": \"PENDING\",\n      \"regionCodes\": [\n        \"PT\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const ids = pm.response.json().data.map(u => u.id);",
                  "pm.collectionVariables.set('bulkIds', JSON.stringify(ids));",
                  "pm.test('3 criados', () => pm.expect(ids).to.have.length(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: e-mail duplicado no lote (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "bulk"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"name\": \"Dup Um\",\n      \"email\": \"dup@email.com\",\n      \"password\": \"senha-segura\",\n      \"regionCodes\": [\n        \"BR\"\n      ]\n    },\n    {\n      \"name\": \"Dup Dois\",\n      \"email\": \"dup@email.com\",\n      \"password\": \"senha-segura\",\n      \"regionCodes\": [\n        \"BR\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
